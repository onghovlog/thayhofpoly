# ==============================================================================
# SERVER CONFIGURATION (.env)
# ==============================================================================

# Server Port & Environment (development / production)
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas)
# Lưu ý: Nhớ mở Network Access trên MongoDB Atlas (IP của VPS hoặc 0.0.0.0/0)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/thayhotb?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=thayhotb_super_secret_jwt_key_2026_production_ready
JWT_EXPIRE=30d

# YouTube Data API v3 (Tùy chọn - để đồng bộ tự động Playlist & Video)
YOUTUBE_API_KEY=

# Client URL for CORS (Hỗ trợ nhiều URL cách nhau bằng dấu phẩy, hoặc dấu * để mở toàn bộ)
# Ví dụ Local: http://localhost:3000
# Ví dụ Domain VPS: https://yourdomain.com,https://www.yourdomain.com,http://IP_VPS:3000
CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com,http://localhost:3000
