# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/thayhotb
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/thayhotb?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/thayhotb

# JWT Authentication
JWT_SECRET=thayhotb_jwt_secret_key_change_me_in_production
JWT_EXPIRE=30d

# YouTube Data API v3 (Optional - Website will still work with direct embeds and DB if empty)
YOUTUBE_API_KEY=

# Client URL for CORS
CLIENT_URL=http://localhost:3000
