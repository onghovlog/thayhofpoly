# ==============================================================================
# CLIENT CONFIGURATION (.env.local hoặc .env.production)
# ==============================================================================

# Public API Endpoint (Được embed vào JavaScript client lúc build Next.js)
# Nếu dùng domain chính có Nginx reverse proxy /api: /api hoặc https://yourdomain.com/api
# Nếu gọi trực tiếp port: http://IP_VPS:5000/api hoặc https://api.yourdomain.com/api
# Môi trường Local: http://localhost:5000/api
NEXT_PUBLIC_API_URL=https://yourdomain.com/api

# Site URL cho SEO, Canonical, OpenGraph và Sitemap
# Ví dụ: https://yourdomain.com hoặc http://IP_VPS:3000
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# (Tùy chọn) Internal API URL dùng riêng cho Server-Side Rendering (SSR) trên VPS
# Nếu không điền, mặc định hệ thống sẽ dùng http://127.0.0.1:5000
INTERNAL_API_URL=http://127.0.0.1:5000
